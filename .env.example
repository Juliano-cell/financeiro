# Segredo temporário usado apenas para vincular usuários importados às novas senhas.
# Em produção, configure com `wrangler secret put`; não salve o valor neste arquivo.
LEGACY_ACCOUNT_CLAIM_SECRET=

# Configure apenas como secrets no Cloudflare; nunca versione valores reais.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LINK_CODE_SECRET=
NOTIFICATION_CRON_SECRET=

# Fail closed: somente o valor textual "true" habilita cada automação.
NOTIFICATION_PLANNER_ENABLED=false
NOTIFICATION_DISPATCHER_ENABLED=false
